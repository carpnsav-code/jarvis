# Copy to .env and fill in your keys. .env is gitignored — never commit real keys.

# --- Providers (required for the live end-to-end loop) ---
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- The brain (LLM) ---
# Default is Haiku 4.5: the speed-critical tier, lowest time-to-first-token,
# best for a real-time voice loop. Swap in a higher-quality tier any time —
# these drop in unchanged:
#   claude-haiku-4-5   (default — fastest)
#   claude-sonnet-5    (near-Opus quality, still quick)
#   claude-opus-4-8    (highest quality, highest latency)
JARVIS_MODEL=claude-haiku-4-5
JARVIS_MAX_TOKENS=300

# --- Audio ---
# Cartesia Sonic outputs raw PCM; we request it at the playback sample rate so
# there is NO resample step between synthesis and the speaker (Tier 4).
JARVIS_SAMPLE_RATE=16000
# Cartesia voice id (see https://play.cartesia.ai for voices). Blank = library default.
CARTESIA_VOICE_ID=
# Cartesia model. "sonic-2" / "sonic-turbo" are the low-latency options.
CARTESIA_MODEL=sonic-2

# --- Speech-to-text (Deepgram) ---
DEEPGRAM_MODEL=nova-3

# --- Tier 2: layered end-of-turn detection (all milliseconds) ---
# Fast path: once Deepgram flags a finalized phrase (speech_final), wait only
# this short confirm window before taking the turn.
JARVIS_FAST_CONFIRM_MS=250
# Slow path: if no endpoint signal arrives, never wait longer than this ceiling.
JARVIS_SILENCE_CEILING_MS=1500
# Deepgram endpointing / utterance-end tuning (passed straight to the API).
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000

# --- Tier 5: sign-off detection ---
# Master switch. When true, clear goodbyes end the conversation with no reply
# (and no model call). Conservative by design — biased toward replying.
JARVIS_SIGNOFF_ENABLED=true

# --- Vision: look-at-my-screen ---
# When true, phrases like "what do you see" / "look at my screen" capture the
# screen (all monitors, in the background — works even when minimized) and send
# it to Claude's native vision. No extra provider or key needed.
JARVIS_VISION_ENABLED=true
# Screenshots are downscaled so the long edge is at most this many pixels before
# encoding — keeps vision tokens and latency down for a real-time voice loop.
JARVIS_VISION_MAX_EDGE=1280
