# Copy to .env and fill in your keys. .env is gitignored — never commit real keys.

# --- Providers (required for the live end-to-end loop) ---
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- The brain (LLM) ---
# Default is Haiku 4.5: the speed-critical tier, lowest time-to-first-token,
# best for a real-time voice loop. Swap in a higher-quality tier any time —
# these drop in unchanged:
#   claude-haiku-4-5   (default — fastest)
#   claude-sonnet-5    (near-Opus quality, still quick)
#   claude-opus-4-8    (highest quality, highest latency)
JARVIS_MODEL=claude-haiku-4-5
JARVIS_MAX_TOKENS=300

# --- Audio ---
# Cartesia Sonic outputs raw PCM; we request it at the playback sample rate so
# there is NO resample step between synthesis and the speaker (Tier 4).
JARVIS_SAMPLE_RATE=16000
# Cartesia voice id (see https://play.cartesia.ai for voices). Blank = library default.
CARTESIA_VOICE_ID=
# Cartesia model. "sonic-2" / "sonic-turbo" are the low-latency options.
CARTESIA_MODEL=sonic-2

# --- Speech-to-text (Deepgram) ---
DEEPGRAM_MODEL=nova-3

# --- Tier 2: layered end-of-turn detection (all milliseconds) ---
# Fast path: once Deepgram flags a finalized phrase (speech_final), wait only
# this short confirm window before taking the turn.
JARVIS_FAST_CONFIRM_MS=250
# Slow path: if no endpoint signal arrives, never wait longer than this ceiling.
JARVIS_SILENCE_CEILING_MS=1500
# Deepgram endpointing / utterance-end tuning (passed straight to the API).
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000

# --- Tier 5: sign-off detection ---
# Master switch. When true, clear goodbyes end the conversation with no reply
# (and no model call). Conservative by design — biased toward replying.
JARVIS_SIGNOFF_ENABLED=true

# --- Computer control + web search (electron/) ---
# The Electron interface (see electron/README.md) works keyless: app launching,
# the YouTube player, and DuckDuckGo/weather/market/Instagram search all run
# with no keys. These are optional enhancements:
#
# Groq is the assistant's brain (chat replies), and also powers the "search
# gate" and background memory extraction. Add up to four keys for automatic
# failover — when one hits a rate limit the assistant rotates to the next and
# never stops responding. GROQ_API_KEY is the primary; the rest are optional.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Optional: shape the assistant's personality (a system prompt run every turn).
GROQ_PERSONALITY=
# Optional: the exact line spoken once when the app boots.
JARVIS_GREETING=Jarvis online. How can I help?

# Optional Layer-2 web search fallback, used only if DuckDuckGo returns nothing.
BRAVE_API_KEY=

# --- Voice output (electron/) ---
# Voice output works keyless via the browser's Web Speech API. For the real
# JARVIS voice, add just an ElevenLabs key — it defaults to a composed British
# voice ("Daniel"). Optionally override with any voice id from your ElevenLabs
# voice library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Spotify voice control (optional; requires Spotify Premium). Create a free app
# at developer.spotify.com/dashboard, add the redirect URI
# http://127.0.0.1:8888/callback, and enable the scopes user-read-playback-state,
# user-modify-playback-state, user-read-currently-playing. These live in the
# Electron main process only — never expose them to the renderer.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- GoHighLevel (live CRM control, optional) ---
# Lets Jarvis actually operate your GHL account by voice ("what are my open
# deals", "text Sam saying I'm running late"). Create a Private Integration in
# GHL (Settings > Other Settings > Private Integrations) with read/write scopes
# for Contacts, Opportunities, Calendars, and Conversations; copy the token and
# your Location ID. Kept in the main process only, never the renderer.
GHL_API_TOKEN=
GHL_LOCATION_ID=
